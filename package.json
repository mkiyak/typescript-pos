{
  "name": "typescript-pos",
  "version": "0.10.0",
  "description": "Turkish bank virtual POS (sanal POS) gateways for Node.js, written in TypeScript",
  "author": "Mehmet Kıyak (https://github.com/mkiyak)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkiyak/typescript-pos.git"
  },
  "bugs": {
    "url": "https://github.com/mkiyak/typescript-pos/issues"
  },
  "homepage": "https://github.com/mkiyak/typescript-pos#readme",
  "keywords": [
    "sanal-pos",
    "virtual-pos",
    "nestpay",
    "asseco",
    "payflex",
    "vakifbank",
    "isbank",
    "ziraat",
    "3d-secure",
    "turkey",
    "payment"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "lint": "biome check .",
    "lint:package": "publint --strict && attw --pack .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:functional": "FUNCTIONAL_TESTS=1 vitest run tests/functional",
    "check": "npm run lint && npm run typecheck && npm run typecheck:examples && npm run test && npm run build && npm run lint:package",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
